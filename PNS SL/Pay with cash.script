//This script is a stub, don't run this directly
//Call this from another script like this: Load "Pay with cash"

Alias "Complete sale" 1758 740
Alias cash_dialog 506 366
Alias top_button 552 173
Alias "Print least" 484 250

//complete cash payment
//assumes there is at least 1 item in the sale

MouseClick "Complete sale"
Sleep 1000

;asks for Club+ card
Assert memo cash_dialog "Club+ card If your customer has a Club+ card, ask them to scan it now on the Customer Scanner"
ClickButton "formDlg" "No Card"
Sleep 300

ClickButton Payment OK ;this auto selects Cash
Sleep 100

MouseClick top_button
Sleep 100

MouseClick "Print least"
Sleep 1000 ;allows time to complete the sale, ready for next test
